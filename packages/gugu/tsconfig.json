{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@app/*": ["./app/*"]
    },
    "lib": ["DOM", "ESNext"],
    // "experimentalDecorators": true,
    // "emitDecoratorMetadata": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "types/**/*", "app"],
  "exclude": ["node_modules/*", "__sapper__/*", "public/*"]
}
